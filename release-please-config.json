{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "bootstrap-sha": "f2af7c5ce509a15746cbd24f5cf8647b1ce22638",
  "pull-request-title-pattern": "chore: release version ${version}",
  "pull-request-header": ":robot: Preparing to release next version",
  "pull-request-footer": "This pull request was generated by release-please.",
  "packages": {
    ".": {
      "extra-files": [
        "Directory.Build.props"
      ]
    }
  },
  "changelog-sections": [
    {
      "type": "feat",
      "section": "New features"
    },
    {
      "type": "fix",
      "scope": "deps",
      "section": "Upgrades"
    },
    {
      "type": "fix",
      "section": "Bug fixes"
    },
    {
      "type": "perf",
      "section": "Performance improvements"
    },
    {
      "type": "revert",
      "section": "Reverts"
    }
  ]
}